# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=industrial_manuals
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM SOLO para consulta (opcional). La ingestión de PDFs NUNCA usa LLM.
# Sin clave → fallback extractivo (0 créditos).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# App
EQUIPMENT_REGISTRY_PATH=data/equipment_registry.json
SAMPLE_CHUNKS_PATH=data/sample_chunks
INGEST_BATCH_SIZE=32
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
